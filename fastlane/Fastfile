default_platform(:ios)

platform :ios do
  desc "Git Pull -> Capacitor 동기화 -> 빌드 번호 +1 -> TestFlight 배포"
  lane :beta do
    # 1. 최신 Git 코드 자동으로 가져오기
    git_pull

    # 2. 최신 웹 코드 빌드 및 Capacitor iOS 동기화
    sh("cd .. && npm run build && npx cap sync ios")

    # 3. App Store Connect API 키 인증
    api_key = app_store_connect_api_key(
      key_id: "GUPU6MF67P",
      issuer_id: "dd22b195-cf15-49cb-bf5a-e9be05a8816a",
      key_filepath: "./fastlane/AuthKey_GUPU6MF67P.p8"
    )

    # 4. App Store Connect 최신 빌드 번호 가져와 +1 자동 증가
    increment_build_number(
      api_key: api_key,
      live: false
    )

    # 5. iOS 앱 빌드
    build_app(
      scheme: "AIcoach",
      export_method: "app-store"
    )

    # 6. TestFlight 업로드
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
